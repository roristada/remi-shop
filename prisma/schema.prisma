// Prisma manages ONLY the `public` application schema.
// Never run `prisma db pull` / `migrate reset` against Supabase-owned schemas (auth, storage).
// Supabase-specific SQL (auth trigger, RLS, grants, partial indexes) lives in hand-written
// migrations — see prisma/migrations/*_supabase_*.
//
// Conventions: UUID PKs, snake_case tables/columns, money = Decimal(10,2) in THB,
// timestamps = timestamptz (stored UTC, displayed Asia/Bangkok).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum CategoryStatus {
  ACTIVE
  HIDDEN
}

/// ARCHIVED folders are hidden from the storefront folder view; their products
/// keep their own publish state.
enum FolderStatus {
  ACTIVE
  ARCHIVED
}

/// Admin-controlled publication state. The customer-facing status
/// (DRAFT/SCHEDULED/ACTIVE/DISABLED/ENDED) is DERIVED server-side from this
/// plus saleStartAt/saleEndAt — see lib/products/status.ts.
enum PublishStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum OrderStatus {
  PENDING_PAYMENT
  WAITING_REVIEW
  PAYMENT_REJECTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  WAITING
  REVIEWING
  APPROVED
  REJECTED
}

/// Outcome of the automatic slip check. Anything but PASSED leaves the slip for the admin.
enum SlipCheckResult {
  PASSED
  AMOUNT_MISMATCH
  RECEIVER_MISMATCH
  DUPLICATE
  BEFORE_ORDER
  NOT_FOUND
  UNREADABLE
  UNAVAILABLE
}

/// PRODUCT = cart checkout (OrderItems grant downloads). LICENSE = payment for an approved
/// commercial license request; it has no OrderItems, so it never grants file access.
enum OrderKind {
  PRODUCT
  LICENSE
}

/// Review state of a commercial license request. Payment state after approval lives on its Order.
enum LicenseRequestStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

/// In-app (navbar) notification events. Customer types go to the order/request owner; ADMIN_* go to every admin.
enum NotificationType {
  PRODUCT_UPDATED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  LICENSE_APPROVED
  LICENSE_REJECTED
  ADMIN_SLIP_SUBMITTED
  ADMIN_LICENSE_REQUESTED
  REVIEW_REMINDER
}

// ───────────────────────────── Users ─────────────────────────────

/// 1:1 with auth.users (id = auth.users.id). Created by trigger on signup.
model Profile {
  id          String   @id @db.Uuid
  email       String   @unique
  displayName String?  @map("display_name")
  avatarPath  String?  @map("avatar_path")
  role        Role     @default(CUSTOMER)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart             Cart?
  wishlist         Wishlist[]
  orders           Order[]
  downloads        Download[]
  reviewedPayments Payment[]        @relation("PaymentReviewer")
  licenseRequests  LicenseRequest[]
  reviewedLicenses LicenseRequest[] @relation("LicenseReviewer")
  reviews          Review[]
  notifications    Notification[]

  @@map("profiles")
}

// ──────────────────────────── Catalog ────────────────────────────

model Category {
  id            String         @id @default(uuid(7)) @db.Uuid
  slug          String         @unique
  nameTH        String         @map("name_th")
  nameEN        String         @map("name_en")
  descriptionTH String?        @map("description_th")
  descriptionEN String?        @map("description_en")
  imagePath     String?        @map("image_path")
  status        CategoryStatus @default(ACTIVE)
  sortOrder     Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@index([status, sortOrder])
  @@map("categories")
}

/// Seller-defined grouping (brand / collection) shown as sections on /shop.
/// Independent of Category (file type). A product is in at most one folder.
model Folder {
  id        String       @id @default(uuid(7)) @db.Uuid
  slug      String       @unique
  nameTH    String       @map("name_th")
  nameEN    String       @map("name_en")
  status    FolderStatus @default(ACTIVE)
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@index([status, sortOrder])
  @@map("folders")
}

model Product {
  id            String @id @default(uuid(7)) @db.Uuid
  slug          String @unique
  nameTH        String @map("name_th")
  nameEN        String @map("name_en")
  descriptionTH String @default("") @map("description_th")
  descriptionEN String @default("") @map("description_en")

  categoryId String @map("category_id") @db.Uuid

  folderId        String? @map("folder_id") @db.Uuid
  /// Position inside the folder (admin drag order).
  folderSortOrder Int     @default(0) @map("folder_sort_order")

  price           Decimal  @db.Decimal(10, 2)
  /// 0 < discountPercent < 100. Applies only within [discountStartAt, discountEndAt].
  discountPercent Decimal? @map("discount_percent") @db.Decimal(5, 2)

  saleStartAt     DateTime? @map("sale_start_at") @db.Timestamptz(6)
  saleEndAt       DateTime? @map("sale_end_at") @db.Timestamptz(6)
  discountStartAt DateTime? @map("discount_start_at") @db.Timestamptz(6)
  discountEndAt   DateTime? @map("discount_end_at") @db.Timestamptz(6)

  publishStatus PublishStatus @default(DRAFT) @map("publish_status")
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz(6)

  // Software compatibility
  supportedVersion String? @map("supported_version") // e.g. "PRO / EX 2.0+"
  fileFormat       String? @map("file_format") // e.g. ".sut"
  license          String? // e.g. "Personal Use"
  requirementsTH   String? @map("requirements_th")
  requirementsEN   String? @map("requirements_en")

  /// Denormalized from visible reviews (kept in step inside the review transactions).
  ratingCount Int @default(0) @map("rating_count")
  ratingSum   Int @default(0) @map("rating_sum")

  /// null = unlimited downloads
  downloadLimit Int? @map("download_limit")

  /// null = unlimited. Units taken are derived from open + completed orders (lib/products/stock.ts),
  /// so expired, cancelled and rejected orders free their unit without a counter to keep in step.
  stockLimit Int? @map("stock_limit")

  // SEO
  seoTitleTH        String? @map("seo_title_th")
  seoTitleEN        String? @map("seo_title_en")
  metaDescriptionTH String? @map("meta_description_th")
  metaDescriptionEN String? @map("meta_description_en")
  ogImagePath       String? @map("og_image_path")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category        Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  folder          Folder?               @relation(fields: [folderId], references: [id], onDelete: SetNull)
  images          ProductImage[]
  versions        ProductVersion[]
  wishlist        Wishlist[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  downloads       Download[]
  licensePrices   ProductLicensePrice[]
  licenseRequests LicenseRequest[]
  softwareTags    ProductSoftwareTag[]
  reviews         Review[]
  variants        ProductVariant[]

  @@index([categoryId])
  @@index([folderId, folderSortOrder])
  @@index([publishStatus, publishedAt(sort: Desc)])
  @@index([publishStatus, saleStartAt, saleEndAt])
  // Trigram search. pg_trgm is in the `extensions` schema (on Supabase search_path).
  @@index([nameTH(ops: raw("gin_trgm_ops"))], map: "products_name_th_trgm", type: Gin)
  @@index([nameEN(ops: raw("gin_trgm_ops"))], map: "products_name_en_trgm", type: Gin)
  @@index([fileFormat(ops: raw("gin_trgm_ops"))], map: "products_file_format_trgm", type: Gin)
  @@map("products")
}

/// Canonical software name (e.g. "Procreate"), admin-managed so the shop filter can trust it —
/// unlike the old free-text field, this can't drift into near-duplicate values.
model SoftwareTag {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products ProductSoftwareTag[]

  @@index([isActive, sortOrder])
  @@map("software_tags")
}

/// Product ↔ SoftwareTag membership. No extra attributes (unlike license pricing), so a
/// product's tag list is simply replaced wholesale on save.
model ProductSoftwareTag {
  productId     String @map("product_id") @db.Uuid
  softwareTagId String @map("software_tag_id") @db.Uuid

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  softwareTag SoftwareTag @relation(fields: [softwareTagId], references: [id], onDelete: Cascade)

  @@id([productId, softwareTagId])
  @@index([softwareTagId])
  @@map("product_software_tags")
}

model ProductImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  imagePath  String   @map("image_path")
  altTextTH  String?  @map("alt_text_th")
  altTextEN  String?  @map("alt_text_en")
  /// Optimized WebP copies (animation kept); null until processed, then the original is the fallback.
  cardPath   String?  @map("card_path")
  detailPath String?  @map("detail_path")
  sortOrder  Int      @default(0) @map("sort_order")
  /// The first image by sortOrder; at most one per product (partial unique index in SQL migration).
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// Optional purchasable options (e.g. A/B/C). A product with any variant is bought per variant:
/// each has its own price, discount window and stock, and its own files. The sale window and
/// license stay on the product. A product without variants is sold as before.
model ProductVariant {
  id              String    @id @default(uuid(7)) @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  nameTH          String    @map("name_th")
  nameEN          String    @map("name_en")
  price           Decimal   @db.Decimal(10, 2)
  /// 0 < discountPercent < 100. Applies only within [discountStartAt, discountEndAt].
  discountPercent Decimal?  @map("discount_percent") @db.Decimal(5, 2)
  discountStartAt DateTime? @map("discount_start_at") @db.Timestamptz(6)
  discountEndAt   DateTime? @map("discount_end_at") @db.Timestamptz(6)
  /// null = unlimited. Units taken are derived from orders, like Product.stockLimit.
  stockLimit      Int?      @map("stock_limit")
  /// Admin switch: an inactive variant cannot be bought (existing buyers keep their files).
  isActive        Boolean   @default(true) @map("is_active")
  sortOrder       Int       @default(0) @map("sort_order")
  /// Optional picture of this option (optimized WebP in product-previews).
  imagePath       String?   @map("image_path")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  files      ProductVersionFile[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, sortOrder])
  @@map("product_variants")
}

model ProductVersion {
  id             String    @id @default(uuid(7)) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  versionNumber  String    @map("version_number")
  releaseDate    DateTime  @default(now()) @map("release_date") @db.Timestamptz(6)
  releaseNotesTH String?   @map("release_notes_th")
  releaseNotesEN String?   @map("release_notes_en")
  /// Exactly one latest per product (partial unique index in SQL migration).
  isLatest       Boolean   @default(false) @map("is_latest")
  /// When buyers were told about this version (admin "notify buyers"); set once, blocks resends.
  notifiedAt     DateTime? @map("notified_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  files   ProductVersionFile[]

  @@unique([productId, versionNumber])
  @@map("product_versions")
}

/// Metadata only — binaries live in the private `digital-files` bucket.
model ProductVersionFile {
  id          String   @id @default(uuid(7)) @db.Uuid
  versionId   String   @map("version_id") @db.Uuid
  /// Original display name (shown to customer). Never used as a storage key.
  fileName    String   @map("file_name")
  /// Sanitized, server-generated object key inside `digital-files`.
  storagePath String   @unique @map("storage_path")
  /// Bytes, <= 5 MB (CHECK constraint in SQL migration).
  fileSize    Int      @map("file_size")
  fileType    String   @map("file_type")
  sortOrder   Int      @default(0) @map("sort_order")
  /// null = shared: every buyer of the product gets it. Set = only buyers of that variant.
  variantId   String?  @map("variant_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  version   ProductVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  /// Restrict: a variant with files cannot be deleted (disable it instead).
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  downloads Download[]

  @@index([versionId, sortOrder])
  @@index([variantId])
  @@map("product_version_files")
}

// ─────────────────────────── Shopping ────────────────────────────

model Wishlist {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("wishlists")
}

model Cart {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  /// Required when the product has variants. One line per (product, variant): two partial
  /// unique indexes in SQL, since NULL variant ids would not collide in a plain unique index.
  variantId String?  @map("variant_id") @db.Uuid
  /// Digital goods: always 1 (CHECK constraint in SQL migration).
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

// ──────────────────────────── Orders ─────────────────────────────

/// Source of truth for payment state is the latest Payment row;
/// Order.paymentStatus mirrors it and is updated in the same transaction.
model Order {
  id            String         @id @default(uuid(7)) @db.Uuid
  orderNumber   String         @unique @map("order_number")
  userId        String         @map("user_id") @db.Uuid
  kind          OrderKind      @default(PRODUCT)
  subtotal      Decimal        @db.Decimal(10, 2)
  discount      Decimal        @default(0) @db.Decimal(10, 2)
  total         Decimal        @db.Decimal(10, 2)
  status        OrderStatus    @default(PENDING_PAYMENT)
  /// null until the first slip is uploaded.
  paymentStatus PaymentStatus? @map("payment_status")
  /// PENDING_PAYMENT orders without a slip are cancelled after this time.
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  paidAt        DateTime?      @map("paid_at") @db.Timestamptz(6)
  cancelledAt   DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           Profile         @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  payments       Payment[]
  downloads      Download[]
  licenseRequest LicenseRequest?
  adminNote      OrderAdminNote?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("orders")
}

/// The shop owner's internal note on an order. Its own table (RLS on, no grants) so the
/// customer's "read own orders" access can never include it.
model OrderAdminNote {
  orderId   String   @id @map("order_id") @db.Uuid
  body      String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_admin_notes")
}

/// Snapshot of what was bought — never recomputed from Product.
model OrderItem {
  id                     String  @id @default(uuid(7)) @db.Uuid
  orderId                String  @map("order_id") @db.Uuid
  productId              String  @map("product_id") @db.Uuid
  productNameTHSnapshot  String  @map("product_name_th_snapshot")
  productNameENSnapshot  String  @map("product_name_en_snapshot")
  productVersionSnapshot String? @map("product_version_snapshot")
  /// Set when the product was bought as a variant; grants that variant's files.
  variantId              String? @map("variant_id") @db.Uuid
  variantNameTHSnapshot  String? @map("variant_name_th_snapshot")
  variantNameENSnapshot  String? @map("variant_name_en_snapshot")
  unitPrice              Decimal @map("unit_price") @db.Decimal(10, 2)
  discount               Decimal @default(0) @db.Decimal(10, 2)
  finalPrice             Decimal @map("final_price") @db.Decimal(10, 2)
  quantity               Int     @default(1)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Restrict: products that were sold cannot be hard-deleted (disable instead).
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Restrict: a variant that was sold cannot be hard-deleted (disable instead).
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // One line per (product, variant) per order: partial unique indexes in SQL.
  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

/// One row per slip upload. Re-upload after rejection = new row.
/// At most one non-REJECTED payment per order (partial unique index in SQL).
model Payment {
  id              String           @id @default(uuid(7)) @db.Uuid
  orderId         String           @map("order_id") @db.Uuid
  amount          Decimal          @db.Decimal(10, 2)
  /// Object key inside the private `payment-slips` bucket.
  slipPath        String           @map("slip_path")
  status          PaymentStatus    @default(WAITING)
  reviewedById    String?          @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  rejectReason    String?          @map("reject_reason")
  /// Bank transaction reference read from the slip. Unique, so one transfer can pay one order only.
  transRef        String?          @unique @map("trans_ref")
  /// Automatic slip check (SlipOK). Null when it was not run (not configured). PASSED + no reviewer = auto-approved.
  autoCheckResult SlipCheckResult? @map("auto_check_result")
  autoCheckedAt   DateTime?        @map("auto_checked_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy Profile? @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("payments")
}

/// Download event log. Also used for per-user rate limiting.
model Download {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  fileId       String?  @map("file_id") @db.Uuid
  downloadedAt DateTime @default(now()) @map("downloaded_at") @db.Timestamptz(6)

  user    Profile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  file    ProductVersionFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([userId, downloadedAt(sort: Desc)])
  @@index([orderId, productId])
  @@map("downloads")
}

// ─────────────────────── Commercial license ──────────────────────

/// Admin-managed global list (e.g. "Merchandise", "Book cover"). Inactive types keep their
/// product prices but are not offered to customers.
model LicenseUsageType {
  id            String   @id @default(uuid(7)) @db.Uuid
  nameTH        String   @map("name_th")
  nameEN        String   @map("name_en")
  descriptionTH String?  @map("description_th")
  descriptionEN String?  @map("description_en")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  prices       ProductLicensePrice[]
  requestItems LicenseRequestItem[]

  @@index([isActive, sortOrder])
  @@map("license_usage_types")
}

/// A row means the product offers this usage type at this price; no row = not offered.
/// The product discount never applies to license prices.
model ProductLicensePrice {
  productId   String  @map("product_id") @db.Uuid
  usageTypeId String  @map("usage_type_id") @db.Uuid
  price       Decimal @db.Decimal(10, 2)

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  usageType LicenseUsageType @relation(fields: [usageTypeId], references: [id], onDelete: Cascade)

  @@id([productId, usageTypeId])
  @@index([usageTypeId])
  @@map("product_license_prices")
}

/// A customer's request for commercial rights to a product. The price is locked at submit.
/// On approval an Order (kind LICENSE) is created and the normal slip flow takes over.
model LicenseRequest {
  id                    String               @id @default(uuid(7)) @db.Uuid
  userId                String               @map("user_id") @db.Uuid
  productId             String               @map("product_id") @db.Uuid
  productNameTHSnapshot String               @map("product_name_th_snapshot")
  productNameENSnapshot String               @map("product_name_en_snapshot")
  buyerName             String               @map("buyer_name")
  buyerEmail            String               @map("buyer_email")
  buyerContact          String               @map("buyer_contact")
  artistName            String               @map("artist_name")
  artistContact         String               @map("artist_contact")
  platform              String
  note                  String?
  /// Object key inside the private `license-artworks` bucket; null until the customer attaches it.
  artworkPath           String?              @map("artwork_path")
  total                 Decimal              @db.Decimal(10, 2)
  status                LicenseRequestStatus @default(PENDING_REVIEW)
  rejectReason          String?              @map("reject_reason")
  reviewedById          String?              @map("reviewed_by") @db.Uuid
  reviewedAt            DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  cancelledAt           DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  /// Set on approval.
  orderId               String?              @unique @map("order_id") @db.Uuid
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       Profile              @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Restrict: products with license requests cannot be hard-deleted (disable instead).
  product    Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  reviewedBy Profile?             @relation("LicenseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  order      Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items      LicenseRequestItem[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([productId])
  @@map("license_requests")
}

/// Snapshot of each usage type picked in a request and its price at submit time.
model LicenseRequestItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  requestId      String  @map("request_id") @db.Uuid
  usageTypeId    String  @map("usage_type_id") @db.Uuid
  nameTHSnapshot String  @map("name_th_snapshot")
  nameENSnapshot String  @map("name_en_snapshot")
  price          Decimal @db.Decimal(10, 2)

  request   LicenseRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// Restrict: a usage type that was requested cannot be deleted (deactivate instead).
  usageType LicenseUsageType @relation(fields: [usageTypeId], references: [id], onDelete: Restrict)

  @@unique([requestId, usageTypeId])
  @@index([usageTypeId])
  @@map("license_request_items")
}

// ─────────────────────────── Content ─────────────────────────────

model Announcement {
  id            String    @id @default(uuid(7)) @db.Uuid
  titleTH       String    @map("title_th")
  titleEN       String    @map("title_en")
  descriptionTH String?   @map("description_th")
  descriptionEN String?   @map("description_en")
  imagePath     String?   @map("image_path")
  link          String?
  startAt       DateTime? @map("start_at") @db.Timestamptz(6)
  endAt         DateTime? @map("end_at") @db.Timestamptz(6)
  isActive      Boolean   @default(true) @map("is_active")
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, startAt, endAt])
  @@map("announcements")
}

// ─────────────────────────── Settings ────────────────────────────
// Singleton rows (id = 1, enforced by CHECK in SQL migration).

model PaymentSetting {
  id              Int      @id @default(1)
  promptPayName   String   @default("") @map("promptpay_name")
  promptPayNumber String   @default("") @map("promptpay_number")
  /// Object key inside `product-previews` (public) — QR is not secret.
  qrImagePath     String?  @map("qr_image_path")
  instructionsTH  String?  @map("instructions_th")
  instructionsEN  String?  @map("instructions_en")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("payment_settings")
}

model StoreSetting {
  id                         Int      @id @default(1)
  storeName                  String   @default("Remi Shop") @map("store_name")
  contactEmail               String?  @map("contact_email")
  lineId                     String?  @map("line_id")
  facebookUrl                String?  @map("facebook_url")
  instagramUrl               String?  @map("instagram_url")
  /// Unpaid (no slip) orders auto-cancel after this many minutes.
  orderExpiryMinutes         Int      @default(60) @map("order_expiry_minutes")
  /// Anti-spam: max download requests per user per minute.
  downloadRateLimitPerMinute Int      @default(10) @map("download_rate_limit_per_minute")
  /// Days an approved license request has to be paid before its order is cancelled.
  licensePaymentDays         Int      @default(3) @map("license_payment_days")
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("store_settings")
}

/// A verified buyer's review of a product (one per customer per product).
/// Writes are server-only; `isHidden` lets the admin take a review down without deleting it.
model Review {
  id          String   @id @default(uuid(7)) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  /// The completed order that made this customer eligible.
  orderId     String   @map("order_id") @db.Uuid
  /// 1-5 (CHECK constraint in SQL).
  rating      Int
  /// May be empty: a star rating alone is a review.
  body        String
  /// Shown publicly as "Anonymous"; admins still see who wrote it and from which order.
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  isHidden    Boolean  @default(false) @map("is_hidden")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, isHidden, createdAt(sort: Desc)])
  @@index([userId])
  @@index([isHidden, createdAt(sort: Desc)])
  @@map("reviews")
}

// ──────────────────────────── Notifications ────────────────────────────

/// One row per recipient. The message is rendered from `type` + `params` in the viewer's language,
/// and the link is derived from them too (lib/notifications/rules.ts), so no URL is ever stored.
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  /// Snapshot values for the message: product names, order number, version, reject reason.
  params    Json             @default("{}")
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}
