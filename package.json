    "next": "16.3.6",
    "next-intl": "^4.14.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
