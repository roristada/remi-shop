# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Public key: "sb_publishable_..." (legacy anon JWT also works)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY: "sb_secret_..." (legacy service_role JWT also works)
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Project Settings → Database → Connection string) ---
# Runtime: Supavisor pooler, transaction mode (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations: direct connection or session pooler (port 5432)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM="Remi Shop <noreply@example.com>"

# --- SlipOK slip check (SERVER ONLY; leave empty to review every slip by hand) ---
# Dashboard → branch: the id in https://api.slipok.com/api/line/apikey/<BRANCH_ID>
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=

# --- Cloudflare R2: product preview images (no egress fees). Leave all empty to keep them in Supabase Storage ---
# Public URL of the bucket (custom domain, e.g. https://img.example.com). Setting it switches previews to R2.
NEXT_PUBLIC_PREVIEW_IMAGE_URL=
# SERVER ONLY: R2 → Manage API tokens (Object Read & Write, this bucket only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
